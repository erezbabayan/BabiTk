# Copy to .supabase-local.env (gitignored) and fill in values, then run:
#   .\scripts\go.ps1
#
# Supabase — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=YourStrongPassword123!
# Optional if project already exists:
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# Or create a new project:
# SUPABASE_CREATE=1

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Add BOTH redirect URIs in Google Cloud (Web client):
#   https://scintillating-fly-225.convex.site/api/auth/callback/google   (Convex login)
#   https://<project-ref>.supabase.co/auth/v1/callback               (if using Supabase)
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret