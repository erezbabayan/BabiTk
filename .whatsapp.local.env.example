# Copy to .whatsapp.local.env and fill real Green-API values, then run:
#   node scripts/setup-whatsapp-green.mjs
#
# Create an instance: https://console.green-api.com/
# Authorize by scanning the QR with WhatsApp → Linked devices.

GREEN_API_URL=https://api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=

# Optional: also push the same keys into backend/.env
# WHATSAPP_PROVIDER=green-api
#
# Feature flags default ON in code. Set false here or on the Edge functions to turn one off.
# Users still opt in for briefing, follow-up, and the Friday summary. Cap: 3 a day.
# WHATSAPP_MORNING_BRIEFING=true
# WHATSAPP_FOLLOWUP=true
# WHATSAPP_MULTI_CARD=true
# WHATSAPP_NL_COMMANDS=true
# WHATSAPP_AUTO_CATEGORY=true
# WHATSAPP_SEMANTIC_SEARCH=true
# WHATSAPP_WEEKLY_SUMMARY=true
# WHATSAPP_SHABBAT_MODE=true
# WHATSAPP_HABITS=true
# WHATSAPP_TASK_BREAKDOWN=true
# WHATSAPP_JEWISH_DATES=true
# WHATSAPP_PROACTIVE_DISPATCHER=true
# GOOGLE_CALENDAR_BIDIRECTIONAL=false
