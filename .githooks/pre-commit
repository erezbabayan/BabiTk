#!/bin/sh
# MindTasker — reminder before commit + block secret .env files.

staged=$(git diff --cached --name-only --diff-filter=ACM)

blocked=0
for file in $staged; do
  case "$file" in
    .env|.env.production|.env.local|.supabase-local.env|backend/.env|web/.env|mobile/.env)
      echo "❌ Blocked: $file — secret env files must not be committed."
      blocked=1
      ;;
  esac
done

if [ "$blocked" -ne 0 ]; then
  exit 1
fi

echo ""
echo "📌 MindTasker — לפני שמירה ב-GitHub:"
echo "   1. git push origin main"
echo "   2. CI ירוץ אוטומטית; deploy לשרת אחרי הצלחה (אם הוגדרו secrets)"
echo ""

exit 0
