    "archiver": "^7.0.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "googleapis": "^148.0.0",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "sharp": "^0.34.5",
    "stripe": "^22.2.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.15.30",
    "@types/node-cron": "^3.0.11",
