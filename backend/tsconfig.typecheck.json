{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests and a few services import shared logic from the repo-root shared/
    // directory, which sits outside the build rootDir.
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "exclude": ["node_modules", "dist"]
}
