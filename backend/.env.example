PORT=3001

OPENAI_API_KEY=sk-...

OPENAI_PARSE_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o

# Hebrew ASR (Eliezer / ivrit.ai stack) — self-host via RunPod; do NOT wrap eliezer.ivrit.ai
# When unset, falls back to OpenAI Whisper above.
# HEBREW_ASR_ENGINE=auto
# Prefer free/cheap Groq Whisper when OpenAI quota is exhausted:
# GROQ_API_KEY=
# GEMINI_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Or self-host ivrit.ai (Eliezer stack) on RunPod:
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_WHISPER_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2

# Notebook OCR — aggressive downscale before Vision API (detail: low in code)
OCR_MAX_WIDTH=400
OCR_MAX_HEIGHT=512
OCR_JPEG_QUALITY=40

# Optional: embedding model is text-embedding-3-small (hardcoded)

# Supabase
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# WhatsApp — provider: meta | green-api | whapi
WHATSAPP_PROVIDER=meta

# Meta Cloud API
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=EAA...
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_GRAPH_API_VERSION=v21.0

# Green-API (WHATSAPP_PROVIDER=green-api)
GREEN_API_URL=https://api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=

# Whapi.Cloud (WHATSAPP_PROVIDER=whapi)
WHAPI_API_TOKEN=
WHAPI_WEBHOOK_TOKEN=

# Optional shared secret for POST /api/whatsapp/webhook/inbound
WHATSAPP_INBOUND_WEBHOOK_TOKEN=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback
# Two-way pull stays off until this is true AND the client id/secret are real.
# GOOGLE_CALENDAR_BIDIRECTIONAL=false

# WhatsApp product flags. Default ON when unset. false / 0 / off turns one off.
# Proactive sends still need the user's opt-in and stay under 3 a day.
# WHATSAPP_MORNING_BRIEFING=true
# WHATSAPP_FOLLOWUP=true
# WHATSAPP_MULTI_CARD=true
# WHATSAPP_RECURRENCE=true
# WHATSAPP_UNDO=true
# WHATSAPP_NL_COMMANDS=true
# WHATSAPP_AUTO_CATEGORY=true
# WHATSAPP_SEMANTIC_SEARCH=true
# WHATSAPP_WEEKLY_SUMMARY=true
# WHATSAPP_SHABBAT_MODE=true
# WHATSAPP_HABITS=true
# WHATSAPP_TASK_BREAKDOWN=true
# WHATSAPP_JEWISH_DATES=true
# unset or true: Edge + API send. convex: only Convex. false: no proactive sends.
# WHATSAPP_PROACTIVE_DISPATCHER=true

# Stripe (Premium subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Public URLs (checkout redirects)
WEB_APP_URL=http://localhost:5173
ANDROID_APP_URL=mindtasker://home

# Cron jobs (inbox archive 02:00, daily digest 08:00)
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Jerusalem
CRON_SECRET=your-random-cron-secret

# Full backup (database + Supabase Storage) — runs at 10:00 and 20:00 when backend is up

BACKUP_ENABLED=true

BACKUP_TIMEZONE=Asia/Jerusalem

BACKUP_DIR=../backups

BACKUP_RETENTION_COUNT=14

BACKUP_STORAGE_BUCKET=source-materials

# Backup notification — WhatsApp message with web + Android links after each backup
BACKUP_NOTIFY_ENABLED=true
BACKUP_NOTIFY_PHONES=+972501234567
WEB_APP_URL=http://localhost:5173
ANDROID_APP_URL=mindtasker://home



DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
