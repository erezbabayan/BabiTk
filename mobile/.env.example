EXPO_PUBLIC_DEMO_MODE=false
# Production: leave empty (Convex only). Local Express is optional for legacy/dev.
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:3001
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SYNC_TOKEN=mindtasker-local-sync
EXPO_PUBLIC_SYNC_ENABLED=false
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
EXPO_PUBLIC_USE_CONVEX=true

# Optional quick demo entry on the login screen:
# EXPO_PUBLIC_ALLOW_DEMO_LOGIN=true

# Local demo-only mode (no Convex account login):
# EXPO_PUBLIC_DEMO_MODE=true

# Local demo credentials (demo-only mode):
#   email: demo@mindtasker.local
#   password: demo

# When you have Supabase:
# EXPO_PUBLIC_DEMO_MODE=false
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
