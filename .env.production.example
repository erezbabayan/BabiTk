# Copy to .env.production and fill in values before: docker compose up -d --build

# --- Backend ---
PORT=3001
NODE_ENV=production

OPENAI_API_KEY=
OPENAI_PARSE_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o
OCR_MAX_WIDTH=480
OCR_MAX_HEIGHT=640
OCR_JPEG_QUALITY=45

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
GREEN_API_URL=https://api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=
WHAPI_API_TOKEN=
WHAPI_WEBHOOK_TOKEN=
WHATSAPP_INBOUND_WEBHOOK_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/integrations/google/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

WEB_APP_URL=https://app.yourdomain.com
ANDROID_APP_URL=mindtasker://home

CRON_ENABLED=true
CRON_TIMEZONE=Asia/Jerusalem
CRON_SECRET=

BACKUP_ENABLED=true
BACKUP_TIMEZONE=Asia/Jerusalem
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=14
BACKUP_STORAGE_BUCKET=source-materials
BACKUP_NOTIFY_ENABLED=true
BACKUP_NOTIFY_PHONES=

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Comma-separated origins for CORS (mobile + web). Example:
# CORS_ORIGINS=https://app.yourdomain.com,http://localhost:5173

# --- Web build args (used by docker compose web service) ---
VITE_DEMO_MODE=false
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_USE_CONVEX=true

# --- Convex (backend dev — root .env.local) ---
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=

# --- Mobile (Expo EAS / store builds — not used by docker-compose) ---
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
