# Copy to .env.production and fill in values before: docker compose up -d --build

# --- Backend ---
PORT=3001
NODE_ENV=production

OPENAI_API_KEY=
OPENAI_PARSE_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_VISION_MODEL=gpt-4o
# Hebrew ASR via self-hosted RunPod (ivrit.ai / Eliezer stack). Optional — falls back to OpenAI.
# HEBREW_ASR_ENGINE=auto
# GROQ_API_KEY=
# GEMINI_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_WHISPER_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
OCR_MAX_WIDTH=480
OCR_MAX_HEIGHT=640
OCR_JPEG_QUALITY=45

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
GREEN_API_URL=https://api.greenapi.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=
# Optional: GREEN-API partner token on the Edge Function auto-creates a per-user instance
# so users can connect with QR / pairing code without pasting keys.
# GREEN_API_PARTNER_TOKEN=
WHAPI_API_TOKEN=
WHAPI_WEBHOOK_TOKEN=
WHATSAPP_INBOUND_WEBHOOK_TOKEN=

# Proactive WhatsApp. Defaults are ON. Set a flag to false to turn that feature off.
# Users must still opt in for briefing, follow-up, and the Friday summary.
# Time zone is always Asia/Jerusalem. Cap: 3 proactive messages per user per day.
# WHATSAPP_MORNING_BRIEFING=true
# WHATSAPP_FOLLOWUP=true
# WHATSAPP_MULTI_CARD=true
# WHATSAPP_RECURRENCE=true
# WHATSAPP_UNDO=true
# WHATSAPP_NL_COMMANDS=true
# WHATSAPP_AUTO_CATEGORY=true
# WHATSAPP_SEMANTIC_SEARCH=true
# WHATSAPP_WEEKLY_SUMMARY=true
# WHATSAPP_SHABBAT_MODE=true
# WHATSAPP_HABITS=true
# WHATSAPP_TASK_BREAKDOWN=true
# WHATSAPP_JEWISH_DATES=true
# Dispatcher: unset or true = Edge + API cron (Convex does not send).
# convex = only Convex sends. false = no proactive sends.
# WHATSAPP_PROACTIVE_DISPATCHER=true
# Two-way Google Calendar pull. Off unless set, and only with real OAuth credentials.
# GOOGLE_CALENDAR_BIDIRECTIONAL=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Live GitHub Pages + Edge:
# GOOGLE_REDIRECT_URI=https://ghibfuinantybqidwadj.supabase.co/functions/v1/google-calendar/callback
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/integrations/google/callback

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

WEB_APP_URL=https://app.yourdomain.com
ANDROID_APP_URL=mindtasker://home

CRON_ENABLED=true
CRON_TIMEZONE=Asia/Jerusalem
CRON_SECRET=

BACKUP_ENABLED=true
BACKUP_TIMEZONE=Asia/Jerusalem
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=14
BACKUP_STORAGE_BUCKET=source-materials
BACKUP_NOTIFY_ENABLED=true
BACKUP_NOTIFY_PHONES=

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Comma-separated origins for CORS (mobile + web). Example:
# CORS_ORIGINS=https://app.yourdomain.com,http://localhost:5173

# --- Web build args (used by docker compose web service) ---
VITE_DEMO_MODE=false
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_USE_CONVEX=false

# --- Convex (backend dev — root .env.local) ---
# CONVEX_DEPLOYMENT=
# CONVEX_URL=
# CONVEX_SITE_URL=

# --- Mobile (Expo EAS / store builds — not used by docker-compose) ---
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
